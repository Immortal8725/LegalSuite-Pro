# Copy to .env and fill values on the host. Do not commit .env.
# None of these are live credentials. Leave a line blank until you have the real value.

# Database. docker compose uses these for the local Postgres container.
# Replace the password before any machine that is not your laptop.
DB_PASSWORD=replace-me
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/legalsuite
DB_USER=legalsuite

# Required when SPRING_PROFILES_ACTIVE=postgres. At least 32 characters. Unique per environment.
# Generate one with: openssl rand -hex 32
SPRING_PROFILES_ACTIVE=postgres
LEGALSUITE_JWT_SECRET=replace-me-with-a-long-random-string

# Public https address of the web app. Used in invite links and as the default CORS origin.
APP_URL=https://app.example.co.za
# Exact browser origins allowed to call the API directly, comma separated. Never *.
CORS_ALLOWED_ORIGINS=https://app.example.co.za
# Root domain for firm public sites on subdomains (ndlovu-partners.example.co.za). Optional.
NEXT_PUBLIC_PUBLIC_SITE_ROOT=
# "native" behind a proxy that sets X-Forwarded-For (compose sets this for you). "none" when
# the API is reached directly, so clients cannot fake their address to dodge the login limit.
FORWARD_HEADERS_STRATEGY=none

# First start of an empty production database: the platform operator account.
# The password must be changed at first sign-in. Remove it from .env afterwards.
LEGALSUITE_OPERATOR_EMAIL=
LEGALSUITE_OPERATOR_PASSWORD=
# Demo firms with the password "password". Only for a staging or demo database.
LEGALSUITE_DEMO_DATA=false

# Sign-in protection. Failed attempts per account and per address in the window.
LOGIN_MAX_FAILURES=8
LOGIN_MAX_FAILURES_PER_IP=40
LOGIN_WINDOW_SECONDS=900
# Access token lifetime in milliseconds (default one hour; the web app refreshes silently).
LEGALSUITE_ACCESS_TOKEN_MS=3600000
# Refresh token lifetime in milliseconds (default seven days).
LEGALSUITE_REFRESH_TOKEN_MS=604800000
# Postgres profile: Flyway owns the schema, Hibernate only validates. Do not change on a live system.
JPA_DDL_AUTO=validate
# HSTS from the API on every response, for a proxy that does not forward X-Forwarded-Proto (see DEPLOY.md section 4).
LEGALSUITE_HSTS_ALWAYS=false
LEGALSUITE_HSTS_MAX_AGE=31536000
# Optional ClamAV (clamd) scan of document uploads. Blank host = off. When on, uploads are refused while clamd is down.
LEGALSUITE_CLAMAV_HOST=
LEGALSUITE_CLAMAV_PORT=3310
LEGALSUITE_CLAMAV_TIMEOUT_MS=15000

# docker compose host ports (all bound to 127.0.0.1). Change if something else uses them.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=18081
WEB_HOST_PORT=3000

# Where uploaded documents and payment proofs are stored. Back this up with the database.
LEGALSUITE_UPLOAD_DIR=

# Call rates in rand per minute, ex VAT. There is no included minute bundle.
# Own landline as caller ID is R149 a month plus the landline rate below.
LEGALSUITE_PSTN_OUTBOUND_PER_MIN=1.49
LEGALSUITE_PSTN_INBOUND_PER_MIN=1.49
LEGALSUITE_PSTN_LANDLINE_PER_MIN=8.90

# Twilio. One account for PSTN calls, SMS, and WhatsApp.
# Leave these blank in git. A trial account can only message numbers you verify in the Twilio console.
# The app reads these from the environment. It does not store them in the database.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public https origin Twilio can reach for call bridges and message status callbacks.
TWILIO_PUBLIC_BASE_URL=
# Optional caller ID when the firm has not saved a number in the app.
TWILIO_VOICE_FROM=

# SMS sender. E.164. Optional if you rent a local number in the app, or set a messaging service below.
# A verified landline cannot send SMS.
TWILIO_SMS_FROM=
# Optional. Looks like MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx. Used for SMS when TWILIO_SMS_FROM is empty.
TWILIO_MESSAGING_SERVICE_SID=
# In-app calls from the attorney app (Twilio Voice SDK). See mobile/README.md.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Optional, for incoming in-app calls (FCM or APNs push credential).
TWILIO_PUSH_CREDENTIAL_SID=

# WhatsApp sender. Blank uses the Twilio sandbox number +14155238886.
# You can also set whatsapp:+14155238886 or your own WhatsApp-enabled number.
# Sandbox: in the Twilio console open Messaging, try WhatsApp, and send the join phrase
# from the test handset to +1 415 523 8886. Freeform messages work for 24 hours after that.
# Outside that window, send an approved template content SID from the staff form.
TWILIO_WHATSAPP_FROM=

# Pay-what-you-use unit prices on the month-end usage invoice. Blank records zero, not a bundle.
LEGALSUITE_SMS_UNIT_COST=0.08
LEGALSUITE_WHATSAPP_UNIT_COST=0.05

# Email: invites (set-password links) and client messages.
# Leave SMTP_HOST empty for dry-run: client messages are logged and invites fall back to a
# one-time password shown to the admin. Local dev: docker compose --profile dev up -d mailpit,
# then SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Draft help stays on the tenant unless both a provider and a key are set.
LEGALSUITE_AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Not used for billing (an earlier design; only the operator credentials check reads them). Product billing is PayFast. Leave blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Web build only. NEXT_OUTPUT=standalone is set by frontend/Dockerfile; NODE_ENV is set by Next.js. Do not set either here.

# PayFast Aggregation. Product billing for Solo, Firm and Practice seats, staff seats and phone minutes.
# Leave blank in git. Sandbox first. Do not put live keys here until KYC is done.
# The passphrase is set in the PayFast merchant settings. Leave it blank only if that merchant has none.
# Return and cancel are browser pages. Notify must reach this API (PayFast POSTs the ITN there).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ENV=sandbox
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
PAYFAST_NOTIFY_URL=
# Local testing only: answer PayFast ITN confirmation and ad hoc charges on this machine.
# Ignored when PAYFAST_ENV=live. Never set on a live system.
PAYFAST_SANDBOX_LOCAL=false

# Browser-facing API origin used by the Next.js rewrite. Inside Docker this is the api service.
NEXT_PUBLIC_API_URL=http://127.0.0.1:18081
